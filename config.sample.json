{
	"defaults": {
		"apiUrl": "https://tts.example.com",
		"speed": 1.0,
		"outputFormat": "mp3",
		"selector": "p, li, blockquote",
		"minChars": 20
	},
	"profiles": {
		"en": {
			"voice": "en_US-amy-low"
		},
		"fr": {
			"voice": "fr_FR-siwis-medium"
		},
		"phonon": {
			"provider": "openai",
			"apiUrl": "https://<your-phonon-host>",
			"timeoutSeconds": 330,
			"fallback": "en"
		},
		"expressive": {
			"provider": "openai",
			"apiUrl": "https://<your-speech-proxy>",
			"model": "gpt-4o-mini-tts",
			"voice": "alloy",
			"instructions": "Read in a calm, even tone."
		}
	}
}
